# The deployed proxy address on Sepolia. Defaults to the address in the repo README.
NEXT_PUBLIC_FLUID_CONTRACT_ADDRESS=0x1874C9971f63Da905291ccdD7348D5811FD91F35

# Sepolia RPC endpoint used for reads and the activity feed.
# The default public endpoint supports full-range eth_getLogs; replace it for production use.
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.gateway.tenderly.co

# Block the proxy was deployed at. Used as the start of the activity log scan.
NEXT_PUBLIC_ACTIVITY_FROM_BLOCK=10383029

# Optional. Without a project ID, only injected wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional overrides.
NEXT_PUBLIC_GITHUB_URL=https://github.com/Y0sefTamer/Fluid-Sepolia
